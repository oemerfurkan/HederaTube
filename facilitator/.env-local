# Operator account: pays gas and submits deposit / claimWithSignature / settle / refundWithSignature
HEDERA_ACCOUNT_ID=
HEDERA_PRIVATE_KEY=
# Optional: account whose key signs ClaimBatch / Refund digests. When set it is advertised as
# `receiverAuthorizer` in /supported so resource servers can delegate authorization to this facilitator.
HEDERA_RECEIVER_AUTHORIZER_ACCOUNT_ID=
HEDERA_RECEIVER_AUTHORIZER_PRIVATE_KEY=
HEDERA_NETWORK=hedera:testnet
# Optional Mirror Node REST base URL override (defaults to the public Mirror Node of HEDERA_NETWORK)
HEDERA_MIRROR_NODE_URL=
# Set to "false" to skip Mirror Node simulation before submitting contract calls
SIMULATE_BEFORE_SEND=true
PORT=4022
