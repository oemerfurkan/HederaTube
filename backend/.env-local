PORT=4021
LOG_LEVEL=info
PUBLIC_BASE_URL=http://localhost:5173
DATABASE_URL=postgres://postgres@localhost:5432/hederatube
REDIS_URL=redis://localhost:6379

# s3 (Garage, production) | fs (local directory, development)
STORAGE_DRIVER=fs
STORAGE_FS_DIR=./storage
S3_ENDPOINT=http://garage:3900
S3_PUBLIC_ENDPOINT=
S3_REGION=garage
S3_BUCKET=hederatube
S3_ACCESS_KEY=
S3_SECRET_KEY=
UPLOAD_MODE=proxy

FACILITATOR_URL=http://localhost:4022
HEDERA_NETWORK=hedera:testnet
HEDERA_MIRROR_NODE_URL=https://testnet.mirrornode.hedera.com
HEDERA_JSON_RPC_URL=https://testnet.hashio.io/api
HEDERA_USDC_TOKEN_ID=0.0.429274
# Faucet payer (HBAR). May reuse the facilitator operator for the hackathon.
HEDERA_OPERATOR_ACCOUNT_ID=
HEDERA_OPERATOR_PRIVATE_KEY=
# Receiver authorizer: signs claim batches and refunds. Lives here, NOT in the facilitator.
HEDERA_RECEIVER_AUTHORIZER_ACCOUNT_ID=
HEDERA_RECEIVER_AUTHORIZER_PRIVATE_KEY=

WITHDRAW_DELAY_SECONDS=900
MAX_TIMEOUT_SECONDS=600
FAUCET_HBAR=5
ABANDONED_AFTER_SECONDS=90
SETTLEMENT_INTERVAL_SECONDS=60
MAX_CLAIMS_PER_BATCH=25
DEV_ENDPOINTS=true
WORLD_VERIFY_MODE=simulate
WORLD_APP_ID=

SEED_CREATOR_ACCOUNT_ID=0.0.10463864
SEED_CREATOR_WALLET=0x00000000000000000000000000000000009faa78
