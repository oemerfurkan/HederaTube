{
  "name": "hederatube-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "HederaTube resource server (x402 batch-settlement on Hedera) and worker",
  "scripts": {
    "dev:api": "tsx watch src/api/main.ts",
    "dev:worker": "tsx watch src/worker/main.ts",
    "start:api": "node dist/src/api/main.js",
    "start:worker": "node dist/src/worker/main.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "seed": "tsx scripts/seed.ts",
    "e2e:testnet": "tsx scripts/e2e-testnet.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/lib-storage": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@hiero-ledger/sdk": "2.85.0",
    "@x402/core": "link:../x402/typescript/packages/core",
    "@x402/express": "link:../x402/typescript/packages/http/express",
    "@x402/fetch": "link:../x402/typescript/packages/http/fetch",
    "@x402/hedera": "link:../x402/typescript/packages/mechanisms/hedera",
    "bullmq": "^5.30.0",
    "compression": "^1.7.5",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.44.0",
    "express": "^4.21.2",
    "ioredis": "^5.4.2",
    "pino": "^9.6.0",
    "postgres": "^3.4.5",
    "redis": "^5.0.0",
    "viem": "^2.48.11",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/compression": "^1.7.5",
    "@types/express": "^5.0.6",
    "@types/node": "^22.13.4",
    "drizzle-kit": "^0.31.0",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.7.3",
    "vitest": "^3.2.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
