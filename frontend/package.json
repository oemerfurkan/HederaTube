  },
  "dependencies": {
    "@x402/core": "link:../x402/typescript/packages/core",
    "@x402/fetch": "link:../x402/typescript/packages/http/fetch",
    "@phosphor-icons/react": "2.1.10",
    "@privy-io/react-auth": "3.42.0",
    "@tanstack/react-query": "5.102.8",
    "@worldcoin/idkit": "4.2.3",
    "gsap": "3.15.0",
    "hls.js": "1.7.2",
    "idb-keyval": "6.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "7.18.3",
    "viem": "2.56.3",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "^22.13.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "5.2.0",
    "fake-indexeddb": "6.2.5",
    "jsdom": "30.0.1",
    "msw": "2.15.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "3.2.7"
