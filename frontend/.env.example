# Privy (required for the embedded wallet; leave empty to use a local dev signer)
VITE_PRIVY_APP_ID=

# real (default) = proxy /api and /stream to VITE_API_TARGET (backend/). mock = MSW in the browser, no backend.
VITE_API_MODE=real
VITE_API_TARGET=http://localhost:4021
# simulate = dev button posts a simulated World ID proof (backend WORLD_VERIFY_MODE=simulate).
VITE_WORLD_VERIFY_MODE=simulate
# Dev-only, local wallet mode: use this funded testnet ECDSA key instead of generating one.
VITE_DEV_PRIVATE_KEY=

# privy | local. Defaults to privy when VITE_PRIVY_APP_ID is set, otherwise local.
VITE_WALLET_MODE=

# mock skips the faucet + HTS allowance approve transactions (renders them as done).
VITE_ONBOARD_MODE=real

VITE_HEDERA_NETWORK=hedera:testnet
VITE_MIRROR_NODE_URL=https://testnet.mirrornode.hedera.com
# Where `readContract` (channels(bytes32)) is simulated. In mock mode MSW serves /mock-mirror.
VITE_MIRROR_CONTRACT_CALL_URL=/mock-mirror
VITE_HASHIO_RPC=https://testnet.hashio.io/api

# Creator payout account used by the mock 402s (any 0.0.x). receiverAuthorizer is its EVM address.
VITE_MOCK_CREATOR_ACCOUNT_ID=0.0.10463864
VITE_MOCK_RECEIVER_AUTHORIZER=0x0000000000000000000000000000000000000000

# World ID (M4) and Squid (M5)
VITE_WORLD_APP_ID=
VITE_WORLD_ACTION=hederatube-creator
# production | staging | sandbox (must match the World app)
VITE_WORLD_ENVIRONMENT=production
VITE_SQUID_INTEGRATOR_ID=
